# Google PageSpeed Insights API key
# Get one at: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=your_api_key_here

# Public site URL (required for SEO canonical URLs, sitemap, Open Graph)
# Example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://lighthouse-compare.vercel.app

# Optional: Google Search Console site verification meta tag content
# GOOGLE_SITE_VERIFICATION=your_verification_code
